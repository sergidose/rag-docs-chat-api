# RAG Docs Chat API — Environment Variables
# Copy this file to .env and fill in your values.

# ── Paths ───────────────────────────────────────────────────────────────────
DATA_DIR=data/raw
MODELS_DIR=models
INDEX_PATH=models/rag_index.joblib

# ── Retrieval ────────────────────────────────────────────────────────────────
RETRIEVER=tfidf
CHUNK_SIZE=120
CHUNK_OVERLAP=30
TOP_K_DEFAULT=5

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO

# CORS: comma-separated allowed origins, or * to allow all
CORS_ORIGINS=*

# ── Security ─────────────────────────────────────────────────────────────────
# Uncomment to protect the POST /ingest endpoint with a static API key.
# API_KEY=your-secret-key-here

# ── LLM-powered answers (optional) ───────────────────────────────────────────
# When set, the /chat endpoint generates answers using Claude instead of
# returning raw extracted text. Falls back to extractive mode if unset.
# ANTHROPIC_API_KEY=sk-ant-...
